---
import { business } from "../data/site";

const { enquire = "#enquire" } = Astro.props as { enquire?: string };
---

<!-- Sticky on phones: the number is always one thumb away. -->
<div
  data-callbar
  class="md:hidden fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto] bg-ground pb-[env(safe-area-inset-bottom)] transition-transform duration-300 ease-out-quart data-[away]:translate-y-full"
>
  <a class="btn min-h-16 text-lead" href={business.phoneHref} data-call-location="sticky_bar">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
    Call {business.phone}
  </a>
  <a class="flex items-center px-5 font-medium text-ink bg-surface" href={enquire}>Enquire</a>
</div>
