---
import { business, enquiryServices, suburbGroups } from "../data/site";

interface Props {
  /** Which form this is in the analytics: "home", "hot-water-systems"... */
  formId: string;
  service?: string;
}

const { formId, service } = Astro.props;
const [first, ...rest] = business.phone.split(" ");
---

<!-- The number is the headline of the page's last screen: the van door, set in type. -->
<section id="enquire" class="on-paper bg-paper text-ink-dark mt-section frame py-16 md:py-24" aria-labelledby="enquire-title">
  <h2 id="enquire-title" class="rise text-lead font-medium max-w-[30ch]">
    Water where it shouldn't be? Call us, any hour.
  </h2>

  <a
    href={business.phoneHref}
    data-call-location="contact"
    class="rise rise-2 group mt-8 md:mt-10 block display tabular-nums whitespace-nowrap text-[23vw] md:text-[13.6vw] leading-[0.85] transition-colors duration-200 hover:text-soft-dark"
    aria-label={`Call ${business.phone}`}
  >
    <span class="block md:inline">{first}</span>{" "}<span class="block md:inline">{rest.join(" ")}</span>
  </a>

  <div class="mt-16 md:mt-24 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <h3 class="text-lead font-medium">Or tell us about the job</h3>
      <p class="mt-4 max-w-[34ch]">
        {business.callbackPromise} After hours, please call: the form is read in the morning.
      </p>
    </div>

    <form
      data-enquiry={formId}
      action="/api/enquiry"
      method="post"
      class="md:col-start-6 md:col-span-7"
      novalidate={false}
    >
      <div data-fields class="grid gap-x-5 gap-y-5 sm:grid-cols-2">
        <label class="flex flex-col gap-2">
          <span class="font-medium">Your name</span>
          <input name="name" required maxlength="80" autocomplete="name" class="field" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="font-medium">Mobile or phone</span>
          <input name="phone" type="tel" required maxlength="30" autocomplete="tel" inputmode="tel" pattern="[0-9 +()\-]{8,}" class="field" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="font-medium">Suburb</span>
          <input name="suburb" required maxlength="60" autocomplete="address-level2" list={`${formId}-suburbs`} class="field" />
          <datalist id={`${formId}-suburbs`}>
            {suburbGroups.flatMap((g) => g.suburbs).map((s) => <option value={s.name} />)}
          </datalist>
        </label>
        <label class="flex flex-col gap-2">
          <span class="font-medium">What's the job?</span>
          <select name="service" required class="field appearance-none bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%2214%22%20height=%2214%22%20viewBox=%220%200%2014%2014%22%3E%3Cpath%20d=%22M2%205l5%205%205-5%22%20fill=%22none%22%20stroke=%22%230c0a08%22%20stroke-width=%222%22/%3E%3C/svg%3E')] bg-no-repeat bg-[right_1rem_center] pr-10">
            {enquiryServices.map((s) => <option value={s} selected={s === service}>{s}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-2 sm:col-span-2">
          <span class="font-medium">What's happening? <span class="font-normal text-soft-dark">Optional</span></span>
          <textarea name="details" rows="4" maxlength="2000" class="field py-3 resize-y"></textarea>
        </label>
        <!-- Bots fill every field; people never see this one. -->
        <div class="hidden" aria-hidden="true">
          <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="page" value={Astro.url.pathname} />
        <div class="sm:col-span-2 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="submit" class="btn btn-dark min-w-48 data-[busy]:opacity-70">Send enquiry</button>
          <p data-status aria-live="polite" class="text-body"></p>
        </div>
      </div>

      <div data-done hidden tabindex="-1" class="outline-none">
        <p class="display text-head" data-done-name>Thanks.</p>
        <p class="mt-5 text-lead max-w-[36ch]">
          We've got your enquiry and we'll ring you back within the hour. Your reference is <span data-done-ref class="font-medium"></span>.
        </p>
        <p class="mt-4">
          Need us sooner? <a class="link font-medium" href={business.phoneHref} data-call-location="form_done">Call {business.phone}</a>
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  @reference "../styles/global.css";
  .field {
    @apply min-h-13 w-full bg-white px-4 text-body text-ink-dark border-2 border-paper-2 outline-none transition-colors duration-150;
  }
  .field:focus {
    @apply border-ink-dark;
  }
  .field:user-invalid {
    @apply border-[#a3341f];
  }
</style>

<script>
  import "../scripts/enquiry";
</script>
