---
import { business, services } from "../data/site";
import { credits } from "../data/photos";

const year = 2026;
---

<footer class="frame overflow-hidden pt-20 md:pt-28 pb-8">
  <p aria-hidden="true" class="display text-poster lowercase leading-[0.8] whitespace-nowrap -ml-[0.04em]">{business.short.toLowerCase()}</p>

  <div class="mt-16 md:mt-18 grid gap-12 md:grid-cols-12">
    <ul class="md:col-span-5 flex flex-col gap-2 text-[clamp(1.625rem,1.3rem+0.9vw,2.25rem)] leading-tight font-medium text-brass">
      <li><a class="tabular-nums transition-colors duration-150 hover:text-brass-strong active:text-brass-strong" href={business.phoneHref} data-call-location="footer">{business.phone}</a></li>
      <li>{business.base}, {business.city}</li>
      <li>Open 24/7</li>
    </ul>

    <nav class="md:col-start-7 md:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-8 text-body" aria-label="Footer">
      <div>
        <h2 class="text-soft">Services</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {services.map((s) => <li><a class="link no-underline hover:underline" href={`/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-soft">On this site</h2>
        <ul class="mt-3 flex flex-col gap-2">
          <li><a class="link no-underline hover:underline" href="/#suburbs">Suburbs</a></li>
          <li><a class="link no-underline hover:underline" href="/#prices">Prices</a></li>
          <li><a class="link no-underline hover:underline" href="/#questions">Questions</a></li>
          <li><a class="link no-underline hover:underline" href="/tracking/">Tracking</a></li>
        </ul>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <h2 class="text-soft">Licensed</h2>
        <ul class="mt-3 flex flex-col gap-2">
          <li>{business.licence}</li>
          <li>{business.abn}</li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="mt-20 md:mt-24 flex flex-col md:flex-row md:items-end md:justify-between gap-6 text-small text-soft">
    <div class="max-w-[60ch] flex flex-col gap-2">
      <p>
        A sample built by Daniil Olekh to show what a new trade website could look like. {business.name}, its phone number, licence and prices are made up. Hidden from search engines and removed on request.
      </p>
      <p>
        Photos from Wikimedia Commons:{" "}
        {credits.map((c, i) => (
          <>
            <a class="link" href={c.page} rel="noopener">{c.title}</a> by {c.creator}, {c.licence}{i < credits.length - 1 ? "; " : "."}
          </>
        ))}
      </p>
      <p>&copy; {year} {business.name}</p>
    </div>
    <a href="#top" class="link shrink-0">Back to top</a>
  </div>
</footer>
