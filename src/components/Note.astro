---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  heading: string;
  text: string;
  photo?: { image: ImageMetadata; alt: string; caption: string };
}
const { heading, text, photo } = Astro.props;
// The first sentence is the advice and is set large; the rest reads at body size under it.
const [first, ...rest] = text.split(/(?<=\.)\s+/);
const more = rest.join(" ");
---

<!-- One piece of advice set large on its own field of colour, with a picture of where it applies. -->
<section class="mt-section bg-surface frame py-20 md:py-28" aria-labelledby="note-title">
  <div class="grid gap-10 lg:gap-6 lg:grid-cols-12 lg:items-end">
    <div class:list={[photo ? "lg:col-span-7" : "lg:col-span-10"]}>
      <h2 id="note-title" class="rise text-lead font-medium text-brass">{heading}</h2>
      <p class="rise rise-2 mt-6 text-[clamp(1.5rem,1.1rem+1.2vw,2.25rem)] leading-[1.2] font-medium max-w-[38ch]">
        {first}
      </p>
      {more && <p class="rise rise-3 mt-5 max-w-[46ch] text-soft">{more}</p>}
    </div>
    {
      photo && (
        <figure class="rise rise-2 md:max-w-[28rem] lg:max-w-none lg:col-start-9 lg:col-span-4">
          <Picture
            src={photo.image}
            alt={photo.alt}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 32vw, (min-width: 768px) 28rem, 100vw"
            formats={["avif", "webp"]}
            quality={58}
            class="w-full aspect-[4/3] object-cover"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="mt-3 text-small text-soft">{photo.caption}</figcaption>
        </figure>
      )
    }
  </div>
</section>
